diff --git a/arch/arm64/boot/dts/exynos/Makefile b/arch/arm64/boot/dts/exynos/Makefile
index f7aae6a06..eb315c732 100644
--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -21,3 +21,4 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynos990-x1slte.dtb		\
 	exynosautov9-sadk.dtb		\
 	exynosautov920-sadk.dtb
+dtb-$(CONFIG_ARCH_EXYNOS) += exynos7885-a30.dtb
diff --git a/arch/arm64/boot/dts/exynos/exynos7885-a30.dts b/arch/arm64/boot/dts/exynos/exynos7885-a30.dts
new file mode 100644
index 000000000..31634d9fd
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos7885-a30.dts
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/linux-event-codes.h>
+#include "exynos7885.dtsi"
+
+/ {
+	model = "Samsung Galaxy A30";
+	compatible = "samsung,a30", "samsung,exynos7885";
+	chassis-type = "handset";
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+		stdout-path = "fb0";
+
+		fb0: framebuffer@ec000000 {
+			compatible = "simple-framebuffer";
+			reg = <0x0 0xec000000 (1080 * 2340 * 4)>;
+			width = <1080>;
+			height = <2340>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		framebuffer_region@ec000000 { reg = <0x0 0xec000000 0x1400000>; no-map; };
+		tima_region@b8000000        { reg = <0x0 0xb8000000 0x200000>;  no-map; };
+		sec_debug_magic@80000000    { reg = <0x0 0x80000000 0x1000>;    no-map; };
+		seclog_mem@c0000000         { reg = <0x0 0xc0000000 0x80000>;   no-map; };
+		wifibt_if@e9000000          { reg = <0x0 0xe9000000 0x400000>;  no-map; };
+		abox_rmem: memory@e9400000  { reg = <0x0 0xe9400000 0x400000>; };
+		modem_if@f5400000           { reg = <0x0 0xf5400000 0x8800000>; no-map; };
+		cp_ram_logging@fdc00000     { reg = <0x0 0xfdc00000 0x2000000>; no-map; };
+		gnss_if@ffc00000            { reg = <0x0 0xffc00000 0x400000>;  no-map; };
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3bc00000>,
+		      <0x0 0xc0000000 0x40000000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+/ {
+	gpio-keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_power &key_voldown &key_volup>;
+
+		key-power {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+
+		key-voldown {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
+		};
+
+		key-volup {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&pinctrl_alive {
+	key_power: key-power-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa1-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa1-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
+
+/ {
+	tsp_ldo_en: regulator-tsp-ldo-en {
+		compatible = "regulator-fixed";
+		regulator-name = "tsp_ldo_en";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		gpios = <&gpg2 1 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&pinctrl_alive {
+	touch_irq: touch-irq-pins {
+		samsung,pins = "gpa0-0";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
+
+&i2c_4 {
+	status = "okay";
+	samsung,i2c-sda-delay = <100>;
+	samsung,i2c-max-bus-freq = <400000>;
+
+	touchscreen@48 {
+		compatible = "melfas,mip4_ts";
+		reg = <0x48>;
+		interrupt-parent = <&gpa0>;
+		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touch_irq>;
+	};
+};
+
+&mmc_0 {
+	status = "okay";
+	bus-width = <8>;
+	non-removable;
+	broken-cd;
+	no-sd;
+	no-sdio;
+	samsung,dw-mshc-ciu-div = <3>;
+	samsung,dw-mshc-sdr-timing = <0 4>;
+	samsung,dw-mshc-ddr-timing = <0 2>;
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos7885.dtsi b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
index 1352c64d1..2c4fc2e3e 100644
--- a/arch/arm64/boot/dts/exynos/exynos7885.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7885.dtsi
@@ -268,7 +268,7 @@ wakeup-interrupt-controller {
 				compatible = "samsung,exynos7885-wakeup-eint",
 					     "samsung,exynos7-wakeup-eint";
 				interrupt-parent = <&gic>;
-				interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>;
+				interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
 			};
 		};
 
diff --git a/drivers/input/touchscreen/melfas_mip4.c b/drivers/input/touchscreen/melfas_mip4.c
index a6946e3d8..7beb9d9ab 100644
--- a/drivers/input/touchscreen/melfas_mip4.c
+++ b/drivers/input/touchscreen/melfas_mip4.c
@@ -355,7 +355,7 @@ static int mip4_query_device(struct mip4_ts *ts)
 		dev_dbg(&ts->client->dev, "event_format: %d, event_size: %d\n",
 			ts->event_format, ts->event_size);
 
-		if (ts->event_format == 2 || ts->event_format > 3)
+		if (ts->event_format == 2 || (ts->event_format > 3 && ts->event_format != 8))
 			dev_warn(&ts->client->dev,
 				 "Unknown event format %d\n", ts->event_format);
 	}
@@ -497,6 +497,21 @@ static void mip4_report_touch(struct mip4_ts *ts, u8 *packet)
 		}
 		break;
 
+	case 8:
+		/* Touch + Force with a 2-byte force value (Samsung MSS100 firmware) */
+		id = (packet[0] & 0x0F) - 1;
+		hover = packet[1] & BIT(2);
+		palm = packet[1] & BIT(1);
+		state = packet[1] & BIT(0);
+		x = ((packet[2] & 0x0F) << 8) | packet[3];
+		y = (((packet[2] >> 4) & 0x0F) << 8) | packet[4];
+		size = packet[7];
+		pressure_stage = (packet[8] & 0xF0) >> 4;
+		pressure = ((packet[8] & 0x0F) << 8) | packet[9];
+		touch_major = packet[10];
+		touch_minor = packet[11];
+		break;
+
 	case 3:
 	default:
 		/* Touch + Force(Pressure) */
@@ -551,6 +566,7 @@ static int mip4_handle_packet(struct mip4_ts *ts, u8 *packet)
 		break;
 
 	case 3:
+	case 8:
 		type = (packet[0] & 0xF0) >> 4;
 		break;
 
